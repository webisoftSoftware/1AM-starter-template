pragma language_version 0.23;

import CompactStandardLibrary;

export ledger totalMinted: Uint<64>;
export ledger mintCount: Counter;
export ledger totalDeposited: Uint<128>;
export ledger depositCount: Counter;

constructor() {
  totalMinted = 0;
  totalDeposited = 0;
}

export circuit mintShielded(
  amount: Uint<64>,
  mintNonce: Bytes<32>,
  recipient: ZswapCoinPublicKey
): [] {
  const coin = mintShieldedToken(
    pad(32, "1am-shielded-mint"),
    disclose(amount),
    disclose(mintNonce),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient))
  );
  assert(coin.color == tokenType(pad(32, "1am-shielded-mint"), kernel.self()), "unexpected token color");

  totalMinted = (totalMinted + disclose(amount)) as Uint<64>;
  mintCount.increment(1);
}

export circuit depositShielded(coin: ShieldedCoinInfo): [] {
  assert(coin.color == tokenType(pad(32, "1am-shielded-mint"), kernel.self()), "invalid token color");

  const received = disclose(coin);
  receiveShielded(received);
  totalDeposited = (totalDeposited + received.value) as Uint<128>;
  depositCount.increment(1);
}
